# Backend Environment Variables (example - copy to .env for local dev)

# PostgreSQL
POSTGRES_DB=nobat
POSTGRES_USER=nobat
POSTGRES_PASSWORD=nobat_dev_password

# Connection String
ConnectionStrings__Default=Host=localhost;Port=5432;Database=nobat;Username=nobat;Password=nobat_dev_password

# JWT
JWT_SECRET=super-secret-dev-key-change-in-production-min-32-characters-long
JWT_ISSUER=nobat
JWT_AUDIENCE=nobat
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# CORS
CORS__ALLOWED_ORIGINS=http://localhost:3000

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# ---------------------------------------------------------------------------
# Docker Compose variables
# Copy to `.env` and adjust. The production stack refuses to start without the
# values marked (required).
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=nobat
POSTGRES_USER=nobat
# (required in production)
POSTGRES_PASSWORD=nobat_dev_password
POSTGRES_PORT=5432

# --- Ports exposed on the host ----------------------------------------------
API_PORT=5000
FRONTEND_PORT=3000

# --- JWT --------------------------------------------------------------------
# (required in production) at least 32 characters
JWT_SECRET=super-secret-dev-key-change-in-production-min-32-characters-long
JWT_ISSUER=nobat
JWT_AUDIENCE=nobat
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# --- Origins ----------------------------------------------------------------
# Browser-facing origin of the Nuxt app; must match the CORS allow-list.
FRONTEND_ORIGIN=http://localhost:3000
# URL the browser uses to reach the API.
PUBLIC_API_BASE=http://localhost:5000

# --- Business rules ---------------------------------------------------------
BUSINESS_TIMEZONE=Asia/Tehran
